rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Replace PASTE_YOUR_UID_HERE with your User UID
// (Firebase console → Authentication → Users → "User UID" column).
//
// Result: only YOUR login can read or write anything. Even if someone else
// managed to create a login in your project, they get "permission denied".

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.uid == '0gISt10iv0WOFKXEPzn5jAMbeYt2';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
